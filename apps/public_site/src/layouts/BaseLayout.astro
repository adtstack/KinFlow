---
import { siteConfig } from '../config/site-config.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  current: 'home' | 'terms' | 'privacy' | 'support' | 'delete';
}

const { title, description, path, current } = Astro.props;
const canonical = new URL(path, `${siteConfig.origin}/`).toString();
const navigation = [
  { key: 'home', href: '/', label: '소개 / About' },
  { key: 'terms', href: '/terms', label: '약관 / Terms' },
  { key: 'privacy', href: '/privacy', label: '개인정보 / Privacy' },
  { key: 'support', href: '/support', label: '지원 / Support' },
  { key: 'delete', href: '/delete-account', label: '계정 삭제 / Delete account' },
] as const;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={siteConfig.robots} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fcfdff" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KinFlow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:locale:alternate" content="en_US" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기 / Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="KinFlow 공개 사이트 홈">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>KinFlow</span>
        </a>
        <nav class="site-nav site-nav-desktop" aria-label="주요 메뉴 / Primary navigation">
          <ul>
            {navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <details class="site-menu">
          <summary>메뉴 / Menu</summary>
          <nav class="site-nav site-nav-mobile" aria-label="모바일 주요 메뉴 / Mobile primary navigation">
            <ul>
              {navigation.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    {!siteConfig.production && (
      <aside class="draft-banner" role="status" aria-label="비게시 개발 초안">
        <div class="shell">
          <strong lang="ko">비게시 개발 초안</strong>
          <span aria-hidden="true"> · </span>
          <span lang="en">Development draft — not an approved or published policy</span>
        </div>
      </aside>
    )}

    <main id="main-content" class="shell main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="footer-brand">KinFlow</p>
          <p lang="ko">가족의 공동 흐름을 위한 성인용 Android 서비스입니다.</p>
          <p lang="en">An adult household coordination service for Android.</p>
        </div>
        <div>
          <p><strong>Policy status</strong>: {siteConfig.policyStatus}</p>
          <p><strong>Policy version</strong>: {siteConfig.policyVersion}</p>
          <p><strong>Published on</strong>: <time datetime={siteConfig.publishedOn}>{siteConfig.publishedOn}</time></p>
        </div>
        <div>
          <p><strong>{siteConfig.developerName}</strong></p>
          <p>{siteConfig.legalEntityName}</p>
          <p lang="ko">이 사이트는 쿠키·분석·추적기를 사용하지 않습니다.</p>
          <p lang="en">This site uses no cookies, analytics, or trackers.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
