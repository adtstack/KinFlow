---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
}

const { eyebrow, title, summary } = Astro.props;
---

<header class="page-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="lede">{summary}</p>
  <nav class="language-nav" aria-label="문서 언어 / Document language">
    <a href="#ko" lang="ko" hreflang="ko">한국어</a>
    <a href="#en" lang="en" hreflang="en">English</a>
  </nav>
</header>
