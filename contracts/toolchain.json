{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "KinFlow implementation baseline",
  "version": "1.0",
  "acceptedAt": "2026-07-23",
  "flutter": {
    "channel": "stable",
    "version": "3.44.7",
    "dart": "3.12.2 bundled with Flutter SDK 3.44.7",
    "pinPolicy": "exact toolchain; .fvmrc and pubspec.lock committed"
  },
  "platforms": {
    "storeMvp": {
      "android": {
        "minApi": 24,
        "targetApi": 36,
        "applicationId": "me.newlines.kinflow",
        "formFactors": [
          "phone",
          "tablet"
        ]
      }
    },
    "deferred": [
      "iOS",
      "iPadOS",
      "Web Companion",
      "Windows native",
      "macOS native",
      "Linux native"
    ]
  },
  "environments": {
    "dev": {
      "applicationId": "me.newlines.kinflow.dev"
    },
    "prod": {
      "applicationId": "me.newlines.kinflow"
    }
  },
  "client": {
    "dependencyAssembly": "flutter_riverpod 3.3.2",
    "routing": "go_router 17.3.0",
    "models": "freezed_annotation 3.1.0 + json_annotation 4.12.0",
    "codegen": "build_runner 2.15.1 + freezed 3.2.5 + json_serializable 6.14.0",
    "localization": "Flutter gen_l10n + intl 0.20.2",
    "theme": "Material 3 light/dark system mode",
    "supabaseFlutter": "2.16.0"
  },
  "backend": {
    "scope": "local development only",
    "supabaseCli": "2.109.1",
    "postgresMajor": 17,
    "edgeRuntime": "Deno 2",
    "remoteProjectLinked": false
  },
  "auth": {
    "authority": "Supabase Auth",
    "initialProvider": "Google",
    "accountAudience": "adults only"
  },
  "policies": {
    "domainMustNotImportFlutterOrSdk": true,
    "generatedCodeCommitted": true,
    "codegenDiffMustBeClean": true,
    "serverAuthoritativeAuthorization": true,
    "noSecretInDartDefine": true,
    "productionProviderSetupRequiresG0Closure": true
  }
}
