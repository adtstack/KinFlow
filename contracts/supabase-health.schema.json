{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinflow.invalid/contracts/supabase-health.schema.json",
  "title": "KinFlow local Supabase health response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "service",
    "contractVersion",
    "environment",
    "requestId"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "service": {
      "const": "kinflow-edge"
    },
    "contractVersion": {
      "const": "2026-07-24"
    },
    "environment": {
      "const": "local"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
